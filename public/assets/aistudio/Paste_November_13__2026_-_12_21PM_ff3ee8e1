  const handleCheckIn = (res: Reservation) => {
    if (!res.roomNumber) {
      setBannerMsg({
        type: "error",
        text: `${res.firstName} ${res.lastName} için henüz oda numarası atanmamış! Karttan oda numarası girip kaydedin.`,
      });
      setResModal({ isOpen: true, mode: "EDIT", target: res });
      return;
    }

    const roomObj = rooms.find((rm) => rm.roomNumber === res.roomNumber);
    if (!roomObj) {
      setBannerMsg({
        type: "error",
        text: `${res.roomNumber} numaralı oda otel tanımlı odalar (4101-4405) arasında bulunamadı.`,
      });
      return;
    }

    const nowTime = new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
    setReservations((prev) =>
      prev.map((r) => (r.id === res.id ? { ...r, lifecycle: "INHOUSE", checkedInAt: nowTime } : r))
    );
    setBannerMsg(null);
  };

