    () => reservations.filter((r) => r.checkOut === systemToday && r.lifecycle === "CHECKED_OUT"),
    [reservations, systemToday]
  );

  const getRoomRackInfo = (room: HotelRoom) => {
    if (room.physicalStatus === "OUT_OF_ORDER") {
      return { status: "OUT_OF_ORDER" as RackDisplayStatus, activeRes: undefined };
    }
    if (room.physicalStatus === "CLOSED_TO_SALES") {
      return { status: "CLOSED_TO_SALES" as RackDisplayStatus, activeRes: undefined };
    }
    const activeRes = reservations.find(
      (r) => r.roomNumber === room.roomNumber && r.lifecycle === "INHOUSE"
    );
    if (activeRes) {
      if (activeRes.checkOut === systemToday) {
        return { status: "DUE_OUT" as RackDisplayStatus, activeRes };
      }
      return { status: "INHOUSE" as RackDisplayStatus, activeRes };
    }
    return { status: "BOS" as RackDisplayStatus, activeRes: undefined };
  };

  const renderSortIcon = (field: SortField) => {
    if (sortField !== field) return <ArrowUpDown className="w-3.5 h-3.5 text-slate-400 opacity-70" />;
    return sortDirection === "asc" ? (
      <ArrowUp className="w-3.5 h-3.5 text-sky-600" />
    ) : (
      <ArrowDown className="w-3.5 h-3.5 text-sky-600" />
    );
  };

  const activeRackRoom = useMemo(
    () => rooms.find((rm) => rm.roomNumber === rackModalRoomNumber) || null,
    [rooms, rackModalRoomNumber]
  );

  return (
    <div className="flex flex-col h-screen bg-slate-100 text-slate-800 font-sans select-none">
      {/* ÜST ANA NAVİGASYON BAR */}
      <header className="flex items-center justify-between px-5 py-2.5 bg-slate-900 text-white border-b border-slate-700 shrink-0">
        <div className="flex items-center gap-6">
          <span className="font-extrabold tracking-wider text-sm text-sky-400">STAYFLOW PMS</span>

          <nav className="flex items-center gap-1.5">
            <button
              onClick={() => setActiveModule("RESERVATION")}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-bold tracking-wide transition cursor-pointer ${
                activeModule === "RESERVATION" ? "bg-sky-600 text-white" : "text-slate-300 hover:bg-slate-800"
              }`}
            >
              <Calendar className="w-3.5 h-3.5" />
              RESERVATION
            </button>

            <button
              onClick={() => setActiveModule("ARRIVALS")}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-bold tracking-wide transition cursor-pointer ${
                activeModule === "ARRIVALS" ? "bg-sky-600 text-white" : "text-slate-300 hover:bg-slate-800"
              }`}
            >
              <LogIn className="w-3.5 h-3.5" />
              ARRIVALS
              <span className="ml-1 bg-emerald-500 text-slate-950 px-1.5 rounded-full text-[10px]">
                {pendingArrivals.length}
              </span>
            </button>

            <button
              onClick={() => setActiveModule("INHOUSE_RACK")}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-bold tracking-wide transition cursor-pointer ${
                activeModule === "INHOUSE_RACK" ? "bg-sky-600 text-white" : "text-slate-300 hover:bg-slate-800"
              }`}
            >
              <BedDouble className="w-3.5 h-3.5" />
              INHOUSE / RACK
            </button>

            <button
              onClick={() => setActiveModule("DUE_OUTS")}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded text-xs font-bold tracking-wide transition cursor-pointer ${
                activeModule === "DUE_OUTS" ? "bg-sky-600 text-white" : "text-slate-300 hover:bg-slate-800"
              }`}
            >
              <LogOut className="w-3.5 h-3.5" />
              DUE OUTS
              <span className="ml-1 bg-amber-400 text-slate-950 px-1.5 rounded-full text-[10px]">
                {dueOutsList.length}
              </span>
            </button>
          </nav>
        </div>

        <div className="flex items-center gap-3">
          <span className="text-xs text-slate-300 hidden sm:inline">
            Tarih: <b className="text-white">{formatTrDate(systemToday)}</b>
          </span>
          <button
            onClick={() => setShowExtraModules(!showExtraModules)}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-semibold text-emerald-400 cursor-pointer"
          >
            <Grid className="w-3.5 h-3.5" />
            Diğer Modüller (5-8)
          </button>
        </div>
      </header>

      {/* ONCLICK DİĞER MODÜLLER (5-8) YER TUTUCU BANDI */}
