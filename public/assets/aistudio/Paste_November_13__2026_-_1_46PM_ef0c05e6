  const [searchQuery, setSearchQuery] = useState("");
  const [dateFilter, setDateFilter] = useState("ALL");
  const [paymentFilter, setPaymentFilter] = useState<"ALL" | PaymentStatus>("ALL");
  const [onlyMultiRoom, setOnlyMultiRoom] = useState(false);
  const [sortField, setSortField] = useState<SortField>("checkIn");
  const [sortDirection, setSortDirection] = useState<SortDirection>("asc");
  const [rackFilter, setRackFilter] = useState<RackDisplayStatus | "ALL">("ALL");

  const getCategoryName = (catId: string) =>
    categories.find((c) => c.id === catId)?.name || "Tanımsız";

  // ==========================================================================
  // ÇAKIŞMA KORUMASI VE İŞ KURALLARI (BUSINESS LOGIC)
  // ==========================================================================

  // KURAL 1: RESERVATION / ARRIVALS KAYIT & DÜZENLEME TARİH ÇAKIŞMASI KONTROLÜ
  const handleSaveReservation = (saved: Reservation, isNew: boolean): boolean => {
    if (saved.roomNumber) {
      // 1A. Tanımlı bir oda numarası mı?
      const roomObj = rooms.find((rm) => rm.roomNumber === saved.roomNumber);
      if (!roomObj) {
        setConflictPopup({
          title: "GEÇERSİZ ODA NUMARASI",
          message: `"${saved.roomNumber}" numaralı oda otel envanterinde (4101–4405) bulunamadı.`,
          detailLine: "Lütfen geçerli bir oda numarası girin veya oda atamasını boş bırakın.",
        });
        return false;
      }

      // 1B. Aynı odada aktif INHOUSE konaklama veya başka bir CONFIRMED rezervasyon ile tarih çakışması var mı?
      const conflictingRes = reservations.find(
        (existing) =>
          existing.id !== saved.id &&
          existing.roomNumber === saved.roomNumber &&
          existing.lifecycle !== "CHECKED_OUT" &&
          isDateRangeOverlapping(
            saved.checkIn,
            saved.checkOut,
            existing.checkIn,
            existing.checkOut
          )
      );

      if (conflictingRes) {
        const statusLabel =
          conflictingRes.lifecycle === "INHOUSE"
            ? "INHOUSE (Şu An Konaklıyor)"
            : "CONFIRMED (Onaylı Rezervasyon)";

        setConflictPopup({
          title: "TARİH VE ODA ÇAKIŞMASI ENGELLENDİ",
          message: `Oda ${saved.roomNumber} seçilen tarih aralığında (${formatTrDate(saved.checkIn)} → ${formatTrDate(saved.checkOut)}) başka bir kayıtla çakışıyor. Değişiklik kaydedilmedi.`,
          detailLine: `Çakışan Kayıt: ${conflictingRes.resCode} • ${conflictingRes.firstName} ${conflictingRes.lastName} (${formatTrDate(conflictingRes.checkIn)} → ${formatTrDate(conflictingRes.checkOut)}) [${statusLabel}]`,
        });
        return false;
      }
    }

    // Çakışma yoksa kaydet ve kartı kapat
    if (isNew) setReservations((prev) => [saved, ...prev]);
    else setReservations((prev) => prev.map((r) => (r.id === saved.id ? saved : r)));
    setResModal({ isOpen: false, mode: "CREATE", target: null });
    return true;
  };

  // KURAL 2: ARRIVALS -> INHOUSE MODÜLÜNDE AKTİF OLAN BİR ODAYA CHECK-IN YAPMAYI ENGELLEME
  const handleCheckIn = (res: Reservation) => {
    // 2A. Oda atanmamışsa kartı aç
    if (!res.roomNumber) {
      setConflictPopup({
        title: "ODA NUMARASI ATANMAMIŞ",
        message: `${res.firstName} ${res.lastName} için henüz oda numarası atanmamış. Check-In öncesinde Rezervasyon Kartından oda seçmelisiniz.`,
      });
      setResModal({ isOpen: true, mode: "EDIT", target: res });
      return;
    }

    const roomObj = rooms.find((rm) => rm.roomNumber === res.roomNumber);
    if (!roomObj) {
      setConflictPopup({
        title: "GEÇERSİZ ODA NUMARASI",
        message: `${res.roomNumber} numaralı oda otel tanımlı odalar (4101-4405) arasında bulunamadı.`,
      });
      return;
    }

    // 2B. Oda OUT OF ORDER veya CLOSED TO SALES ise engelle
    if (roomObj.physicalStatus !== "AVAILABLE") {
      setConflictPopup({
        title: "ODA GİRİŞE KAPALI",
        message: `Oda ${res.roomNumber} şu anda "${roomObj.physicalStatus === "OUT_OF_ORDER" ? "OUT OF ORDER (Arızalı)" : "CLOSED TO SALES (Satışa Kapalı)"}" durumunda olduğu için Check-In yapılamaz.`,
        detailLine: "Önce INHOUSE / RACK ekranından odayı SOLVED durumuna getirin veya başka bir oda atayın.",
      });
      return;
    }

    // 2C. INHOUSE modülünde bu odada halihazırda aktif konaklayan (henüz Check-Out olmamış) bir misafir varsa KESİNLİKLE ENGELLE
    const activeInhouseGuest = reservations.find(
      (r) => r.id !== res.id && r.roomNumber === res.roomNumber && r.lifecycle === "INHOUSE"
    );

    if (activeInhouseGuest) {
      setConflictPopup({
        title: "CHECK-IN ENGELLENDİ — ODA HALİHAZIRDA INHOUSE",
        message: `Oda ${res.roomNumber} şu anda INHOUSE modülünde aktif olarak dolu görünüyor! Mevcut misafirin çıkışı (Check-Out) yapılmadan yeni giriş alınamaz.`,
        detailLine: `Odadaki Aktif Misafir: ${activeInhouseGuest.firstName} ${activeInhouseGuest.lastName} (${activeInhouseGuest.resCode} • Çıkış: ${formatTrDate(activeInhouseGuest.checkOut)})`,
      });
      return;
    }

    // 2D. Gelecek tarihli rezervasyonlarla tarih çakışması varsa engelle
    const futureOverlap = reservations.find(
      (r) =>
        r.id !== res.id &&
        r.roomNumber === res.roomNumber &&
        r.lifecycle === "CONFIRMED" &&
        isDateRangeOverlapping(res.checkIn, res.checkOut, r.checkIn, r.checkOut)
    );

    if (futureOverlap) {
      setConflictPopup({
        title: "TARİH ÇAKIŞMASI — CHECK-IN ENGELLENDİ",
        message: `Oda ${res.roomNumber} için aynı tarihlerde çakışan başka bir onaylı rezervasyon mevcut.`,
        detailLine: `Çakışan Kayıt: ${futureOverlap.resCode} • ${futureOverlap.firstName} ${futureOverlap.lastName} (${formatTrDate(futureOverlap.checkIn)} → ${formatTrDate(futureOverlap.checkOut)})`,
      });
      return;
    }

    // Tüm kontroller temizse CHECK-IN işlemini tamamla
    const nowTime = new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
    setReservations((prev) =>
      prev.map((r) => (r.id === res.id ? { ...r, lifecycle: "INHOUSE", checkedInAt: nowTime } : r))
    );
  };

  const handleUndoCheckIn = (res: Reservation) => {
    setReservations((prev) =>
      prev.map((r) =>
        r.id === res.id ? { ...r, lifecycle: "CONFIRMED", checkedInAt: undefined } : r
      )
    );
  };

  // KURAL 3: DUE OUTS -> ÖDEME AL NOTU İLE EŞLEŞEN CHECK OUT AKSİYONU
  const handleCheckOut = (res: Reservation, collectedNow: number = 0) => {
    const remainingBalance = Math.max(0, res.totalAmount - res.paidAmount);
    const updatedPaidAmount = res.paidAmount + collectedNow;

    if (remainingBalance > 0 && updatedPaidAmount !== res.totalAmount) {
      setConflictPopup({
        title: "AÇIK BAKİYE — CHECK-OUT ENGELLENDİ",
        message: `Oda ${res.roomNumber} (${res.firstName} ${res.lastName}) için ${remainingBalance.toLocaleString("tr-TR")} TL kalan ödeme tahsil edilmeden Check-Out yapılamaz.`,
        detailLine: "ÖDEME AL kutusuna kalan tutarı girerek ödemeyi kapatın.",
      });
      return;
    }

    const nowTime = new Date().toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
    setReservations((prev) =>
      prev.map((r) =>
        r.id === res.id
          ? {
              ...r,
              paidAmount: updatedPaidAmount,
              paymentStatus: "ODENDI",
              lifecycle: "CHECKED_OUT",
              checkedOutAt: nowTime,
            }
          : r
      )
    );

    setDueOutPaymentInputs((prev) => {
      const copy = { ...prev };
      delete copy[res.id];
      return copy;
    });

    if (res.roomNumber) {
      setRooms((prev) =>
        prev.map((rm) => (rm.roomNumber === res.roomNumber ? { ...rm, isDirty: true } : rm))
      );
    }
  };

  const handleUndoCheckOut = (res: Reservation) => {
    // Geri alırken odaya başka biri girmiş mi kontrol et
    const occupiedNow = reservations.find(
      (r) => r.id !== res.id && r.roomNumber === res.roomNumber && r.lifecycle === "INHOUSE"
    );
    if (occupiedNow) {
      setConflictPopup({
        title: "GERİ ALMA ENGELLENDİ",
        message: `Oda ${res.roomNumber} şu anda ${occupiedNow.firstName} ${occupiedNow.lastName} tarafından kullanıldığı için eski Check-Out geri alınamaz.`,
      });
      return;
    }

    setReservations((prev) =>
      prev.map((r) =>
        r.id === res.id ? { ...r, lifecycle: "INHOUSE", checkedOutAt: undefined } : r
      )
    );
  };

  // INHOUSE / RACK -> ODA FİZİKSEL DURUMU DEĞİŞTİRME
  const handleSetRoomPhysicalStatus = (roomNumber: string, newStatus: RoomPhysicalStatus) => {
    setRooms((prev) =>
      prev.map((rm) =>
        rm.roomNumber === roomNumber ? { ...rm, physicalStatus: newStatus } : rm
      )
    );
  };

  const handleOpenRackCard = (room: HotelRoom) => {
    const reqs = roomRequests[room.roomNumber] || { teknik: "", hk: "", resepsiyon: "" };
    setDraftTeknik(reqs.teknik);
    setDraftHk(reqs.hk);
    setDraftResepsiyon(reqs.resepsiyon);
    setRackModalRoomNumber(room.roomNumber);
  };

  const handleSaveRoomReq = (type: keyof RoomRequests, val: string) => {
    if (!rackModalRoomNumber) return;
    setRoomRequests((prev) => ({
      ...prev,
      [rackModalRoomNumber]: {
        ...(prev[rackModalRoomNumber] || { teknik: "", hk: "", resepsiyon: "" }),
        [type]: val.trim(),
      },
    }));
  };

  const handleDeleteRoomReq = (type: keyof RoomRequests) => {
    if (!rackModalRoomNumber) return;
    if (type === "teknik") setDraftTeknik("");
    if (type === "hk") setDraftHk("");
    if (type === "resepsiyon") setDraftResepsiyon("");

    setRoomRequests((prev) => ({
      ...prev,
      [rackModalRoomNumber]: {
        ...(prev[rackModalRoomNumber] || { teknik: "", hk: "", resepsiyon: "" }),
        [type]: "",
      },
    }));
  };

  // ==========================================================================
  // TÜRETİLMİŞ LİSTELER
  // ==========================================================================
  const handleSort = (field: SortField) => {
    if (sortField === field) setSortDirection((p) => (p === "asc" ? "desc" : "asc"));
    else {
      setSortField(field);
      setSortDirection("asc");
    }
  };

  const multiRoomKeys = useMemo(() => {
    const counts: Record<string, number> = {};
    reservations.forEach((r) => {
      const k = r.groupId || `${r.firstName} ${r.lastName}`;
      counts[k] = (counts[k] || 0) + 1;
    });
    return new Set(Object.keys(counts).filter((k) => counts[k] > 1));
  }, [reservations]);

  const filterAndSortList = (list: Reservation[], applyDateFilter: boolean) => {
    const q = searchQuery.toLowerCase().trim();
    const filtered = list.filter((r) => {
      const fullName = `${r.firstName} ${r.lastName}`;
      const isMulti = multiRoomKeys.has(r.groupId || fullName);
      if (onlyMultiRoom && !isMulti) return false;
      if (applyDateFilter && dateFilter !== "ALL" && r.checkIn !== dateFilter) return false;
      if (paymentFilter !== "ALL" && r.paymentStatus !== paymentFilter) return false;
      if (q) {
        const roomStr = (r.roomNumber || "boş").toLowerCase();
        if (
          !fullName.toLowerCase().includes(q) &&
          !r.resCode.toLowerCase().includes(q) &&
          !roomStr.includes(q)
        ) {
          return false;
        }
      }
      return true;
    });

    return [...filtered].sort((a, b) => {
      let comp = 0;
      const nameA = `${a.firstName} ${a.lastName}`;
      const nameB = `${b.firstName} ${b.lastName}`;
      switch (sortField) {
        case "resCode":
          comp = a.resCode.localeCompare(b.resCode, "tr");
          break;
        case "roomNumber":
          comp = (a.roomNumber || "ZZZZ").localeCompare(b.roomNumber || "ZZZZ", "tr");
          break;
        case "guestName":
          comp = nameA.localeCompare(nameB, "tr");
          break;
        case "checkIn":
          comp = a.checkIn.localeCompare(b.checkIn);
          break;
        case "category":
          comp = getCategoryName(a.categoryId).localeCompare(getCategoryName(b.categoryId), "tr");
          break;
        case "paidAmount":
          comp = a.paidAmount - b.paidAmount;
          break;
      }
      if (comp === 0 && nameA === nameB) return a.resCode.localeCompare(b.resCode, "tr");
      return sortDirection === "asc" ? comp : -comp;
    });
  };

