{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "Hotel reservation, active in-house stay, or checked-out folio record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reservation document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "groupId": {
          "type": "string",
          "description": "Optional multi-room group identifier.",
          "maxLength": 64
        },
        "resCode": {
          "type": "string",
          "description": "PNR / reservation confirmation code.",
          "minLength": 2,
          "maxLength": 32
        },
        "roomNumber": {
          "type": "string",
          "description": "Assigned room number or null if unassigned.",
          "maxLength": 16
        },
        "firstName": {
          "type": "string",
          "description": "Guest first name.",
          "minLength": 1,
          "maxLength": 80
        },
        "lastName": {
          "type": "string",
          "description": "Guest last name.",
          "minLength": 1,
          "maxLength": 80
        },
        "checkIn": {
          "type": "string",
          "description": "Check-in date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "checkOut": {
          "type": "string",
          "description": "Check-out date in YYYY-MM-DD format.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "nights": {
          "type": "integer",
          "description": "Number of room nights."
        },
        "categoryId": {
          "type": "string",
          "description": "Room category identifier.",
          "minLength": 1,
          "maxLength": 32
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment state of the reservation.",
          "enum": ["ODENDI", "KISMI_ODENDI", "ODENMEDI"]
        },
        "paidAmount": {
          "type": "number",
          "description": "Amount already collected in TRY."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total reservation and posted charges amount in TRY."
        },
        "notes": {
          "type": "string",
          "description": "Free-text guest or reservation notes.",
          "maxLength": 1000
        },
        "lifecycle": {
          "type": "string",
          "description": "Current reservation lifecycle state.",
          "enum": ["CONFIRMED", "INHOUSE", "CHECKED_OUT", "CANCELLED"]
        },
        "cancellationReason": {
          "type": "string",
          "description": "Note explaining why an active reservation was cancelled.",
          "maxLength": 500
        },
        "cancelledAt": {
          "type": "string",
          "description": "Formatted timestamp when reservation was cancelled.",
          "maxLength": 64
        },
        "cancelledBy": {
          "type": "string",
          "description": "Role label of operator who cancelled the reservation.",
          "maxLength": 64
        },
        "checkedInAt": {
          "type": "string",
          "description": "Check-in time string (HH:mm).",
          "maxLength": 16
        },
        "checkedOutAt": {
          "type": "string",
          "description": "Check-out time string (HH:mm).",
          "maxLength": 16
        },
        "extraCharges": {
          "type": "array",
          "description": "Posted extra room service charges (e.g., laundry, minibar)."
        },
        "checkInRates": {
          "type": "object",
          "description": "Exchange rates locked at room Check-In date to prevent checkout exchange-rate differences."
        },
        "checkInPayment": {
          "type": "object",
          "description": "Check-In day payment recorded in foreign currency or TRY with Check-In date exchange rate locked."
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user owning the workspace.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "resCode",
        "firstName",
        "lastName",
        "checkIn",
        "checkOut",
        "nights",
        "categoryId",
        "paymentStatus",
        "paidAmount",
        "totalAmount",
        "notes",
        "lifecycle",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "HotelRoom": {
      "title": "HotelRoom",
      "description": "Physical hotel room operational and housekeeping status.",
      "type": "object",
      "properties": {
        "roomNumber": {
          "type": "string",
          "description": "Room number identifier (e.g., 4101).",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "floor": {
          "type": "integer",
          "description": "Hotel floor number."
        },
        "categoryId": {
          "type": "string",
          "description": "Room category identifier.",
          "minLength": 1,
          "maxLength": 32
        },
        "physicalStatus": {
          "type": "string",
          "description": "Operational availability status of the room.",
          "enum": ["AVAILABLE", "OUT_OF_ORDER", "CLOSED_TO_SALES"]
        },
        "isDirty": {
          "type": "boolean",
          "description": "Housekeeping dirty flag."
        },
        "isLocked": {
          "type": "boolean",
          "description": "Manager lock flag preventing reception edits."
        },
        "lockedBy": {
          "type": "string",
          "description": "Role label of user who locked the room.",
          "maxLength": 64
        },
        "lockedAt": {
          "type": "string",
          "description": "Timestamp string when room was locked.",
          "maxLength": 64
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user owning the workspace.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "roomNumber",
        "floor",
        "categoryId",
        "physicalStatus",
        "isDirty",
        "isLocked",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomRequest": {
      "title": "RoomRequest",
      "description": "Departmental request and issue notes (Teknik, HK, Resepsiyon) per room.",
      "type": "object",
      "properties": {
        "roomNumber": {
          "type": "string",
          "description": "Room number identifier.",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teknik": {
          "type": "string",
          "description": "Technical maintenance request note.",
          "maxLength": 500
        },
        "hk": {
          "type": "string",
          "description": "Housekeeping request note.",
          "maxLength": 500
        },
        "resepsiyon": {
          "type": "string",
          "description": "Front desk / reception request note.",
          "maxLength": 500
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user owning the workspace.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "roomNumber",
        "teknik",
        "hk",
        "resepsiyon",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized hotel administrator marker document.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email address.",
          "maxLength": 160
        }
      },
      "required": ["email"]
    },
    "PmsSettings": {
      "title": "PmsSettings",
      "description": "Active hotel PMS business date and last closed date.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Settings document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "activeBusinessDate": {
          "type": "string",
          "description": "Current active PMS operating date in YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastClosedDate": {
          "type": "string",
          "description": "Most recently closed business date in YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "rollback20261113Done": {
          "type": "boolean",
          "description": "One-time marker indicating the Nov 13 2026 EOD rollback completed."
        },
        "exchangeRates": {
          "type": "object",
          "description": "Active daily TCMB or manual exchange rates (TRY, EUR, USD, GBP)."
        },
        "activeRateType": {
          "type": "string",
          "description": "Selected TCMB exchange rate basis (FOREX_BUYING or FOREX_SELLING).",
          "enum": ["FOREX_BUYING", "FOREX_SELLING"]
        },
        "tcmbRates": {
          "type": "object",
          "description": "Full TCMB buying/selling rate table for TRY, USD, EUR, GBP."
        },
        "ratesDate": {
          "type": "string",
          "description": "PMS business date YYYY-MM-DD for which active rates were fetched.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "ratesBulletinDate": {
          "type": "string",
          "description": "TCMB bulletin date string.",
          "maxLength": 64
        },
        "ratesSource": {
          "type": "string",
          "description": "Source of active rates (TCMB or MANUEL).",
          "maxLength": 32
        },
        "ratesUpdatedAt": {
          "type": "string",
          "description": "Formatted timestamp when active rates were last updated.",
          "maxLength": 64
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user owning the workspace.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "activeBusinessDate", "ownerId", "createdAt", "updatedAt"]
    },
    "EndOfDayLog": {
      "title": "EndOfDayLog",
      "description": "Immutable closed-day audit snapshot for retroactive End-of-Day reporting.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique End-of-Day log ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessDate": {
          "type": "string",
          "description": "Closed PMS business date in YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "nextBusinessDate": {
          "type": "string",
          "description": "Next active PMS business date in YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "closedAt": {
          "type": "string",
          "description": "Formatted timestamp when day was closed.",
          "minLength": 1,
          "maxLength": 64
        },
        "closedBy": {
          "type": "string",
          "description": "Role/email label of operator who closed the day.",
          "minLength": 1,
          "maxLength": 120
        },
        "totalRooms": { "type": "integer", "description": "Total hotel rooms." },
        "occupiedRooms": { "type": "integer", "description": "Rooms occupied at End of Day." },
        "occupancyRate": { "type": "number", "description": "Occupancy percentage." },
        "availableRooms": { "type": "integer", "description": "Available rooms at close." },
        "blockedRooms": { "type": "integer", "description": "OOO / CTS rooms at close." },
        "cleanRooms": { "type": "integer", "description": "Clean rooms at close." },
        "dirtyRooms": { "type": "integer", "description": "Dirty rooms at close." },
        "arrivalsRealized": { "type": "integer", "description": "Realized check-ins on the closed day." },
        "arrivalsPending": { "type": "integer", "description": "Remaining unarrived reservations on the closed day." },
        "departuresCompleted": { "type": "integer", "description": "Completed check-outs on the closed day." },
        "departuresPending": { "type": "integer", "description": "Pending due-outs remaining at close." },
        "roomRevenue": { "type": "number", "description": "Estimated nightly room revenue in TRY." },
        "extraChargesRevenue": { "type": "number", "description": "Posted extra service charges in TRY." },
        "collectedPayments": { "type": "number", "description": "Collected payments across active/departed stays in TRY." },
        "pendingBalance": { "type": "number", "description": "Remaining unpaid balance in TRY." },
        "adr": { "type": "number", "description": "Average Daily Rate in TRY." },
        "revPar": { "type": "number", "description": "Revenue Per Available Room in TRY." },
        "categoryBreakdown": { "type": "array", "description": "Per-category occupancy snapshot." },
        "guestSnapshots": { "type": "array", "description": "Active and departed guest summary rows at close." },
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated user owning the workspace.",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "businessDate",
        "nextBusinessDate",
        "closedAt",
        "closedBy",
        "totalRooms",
        "occupiedRooms",
        "occupancyRate",
        "availableRooms",
        "blockedRooms",
        "cleanRooms",
        "dirtyRooms",
        "arrivalsRealized",
        "arrivalsPending",
        "departuresCompleted",
        "departuresPending",
        "roomRevenue",
        "extraChargesRevenue",
        "collectedPayments",
        "pendingBalance",
        "adr",
        "revPar",
        "categoryBreakdown",
        "guestSnapshots",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "Real-time hotel reservation, in-house, and due-out records."
    },
    "/rooms/{roomNumber}": {
      "schema": { "$ref": "#/entities/HotelRoom" },
      "description": "Real-time physical room status, cleanliness, and lock state."
    },
    "/room_requests/{roomNumber}": {
      "schema": { "$ref": "#/entities/RoomRequest" },
      "description": "Real-time departmental notes (Teknik, HK, Resepsiyon) per room."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Hotel admin UID registry."
    },
    "/pms_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PmsSettings" },
      "description": "Persisted active PMS business date per workspace."
    },
    "/end_of_day_logs/{reportId}": {
      "schema": { "$ref": "#/entities/EndOfDayLog" },
      "description": "Historical End-of-Day operational and financial snapshots."
    }
  }
}
